{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spacex",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-12",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/music/soundtrack.mp3"],
    "not_found_handling": "none"
  }
}
